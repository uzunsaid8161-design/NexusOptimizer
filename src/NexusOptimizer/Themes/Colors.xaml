<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgBaseColor">#0B0E14</Color>
    <Color x:Key="BgDeepColor">#131829</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="MutedColor">#8B949E</Color>

    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="GlassFill" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GlassBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GridLine" Color="#0DFFFFFF" />

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0E14" Offset="0" />
        <GradientStop Color="#0E1320" Offset="0.55" />
        <GradientStop Color="#131829" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CyanColor}" Offset="0" />
        <GradientStop Color="{StaticResource VioletColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AreaGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5522D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>

