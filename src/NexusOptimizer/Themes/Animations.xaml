<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wiederverwendbare Storyboards. Programmgesteuerte Animationen laufen über den MotionService,
         diese Storyboards sind für rein deklarative Fälle (Trigger, Style.Triggers) gedacht. -->

    <Storyboard x:Key="Anim.FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                         Duration="{StaticResource Motion.Normal}"
                         EasingFunction="{StaticResource Easing.Standard}" />
    </Storyboard>

    <Storyboard x:Key="Anim.PopIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                         Duration="{StaticResource Motion.Normal}"
                         EasingFunction="{StaticResource Easing.Standard}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         From="0.92" To="1" Duration="{StaticResource Motion.Normal}"
                         EasingFunction="{StaticResource Easing.Overshoot}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         From="0.92" To="1" Duration="{StaticResource Motion.Normal}"
                         EasingFunction="{StaticResource Easing.Overshoot}" />
    </Storyboard>

    <Storyboard x:Key="Anim.Shake">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                       Duration="{StaticResource Motion.Slow}">
            <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-6" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="6" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.19" Value="-5" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="4" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="0" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="Anim.LiveDot" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                         Duration="{StaticResource Motion.Ambient}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         From="1" To="1.15" Duration="{StaticResource Motion.Ambient}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         From="1" To="1.15" Duration="{StaticResource Motion.Ambient}" />
    </Storyboard>

</ResourceDictionary>
