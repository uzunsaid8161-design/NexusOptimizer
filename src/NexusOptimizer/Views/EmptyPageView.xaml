<UserControl x:Class="NexusOptimizer.Views.EmptyPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCard}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="◇" FontSize="40" Foreground="#2A3348" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
