<UserControl x:Class="NexusOptimizer.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Pop" b:Animations.Hover="Card">
                <StackPanel>
                    <TextBlock Text="SICHERE BEREINIGUNG" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Der Cleaner prüft nur deinen Benutzer-Temp-Ordner und bietet Dateien an, die seit mindestens sieben Tagen unverändert sind. Sie werden in den Windows-Papierkorb verschoben und können von dort wiederhergestellt werden."
                               Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="800" />
                    <TextBlock Text="{Binding TempPath}" Foreground="{StaticResource Cyan}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="1">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding LargestFiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Erneut prüfen" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" IsEnabled="{Binding CanRun}" />
                        <Button Content="In Papierkorb verschieben" Command="{Binding CleanCommand}" Style="{StaticResource AccentButton}"
                                Margin="10,0,0,0" IsEnabled="{Binding CanRun}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
