<Window x:Class="NexusOptimizer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Overlay" Width="268" Height="184" Left="24" Top="70"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False">
    <Border Background="#E60B0E14" BorderBrush="#5522D3EE" BorderThickness="1" CornerRadius="14" Padding="16"
            Opacity="{Binding OverlayOpacity}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" />
                <TextBlock Text="NEXUS · LIVE" Foreground="#E6EDF3" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" />
            </StackPanel>
            <Grid Visibility="{Binding ShowFps, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,7">
                <TextBlock Text="FPS" Foreground="#8B949E" FontSize="11" />
                <TextBlock Text="{Binding FpsText}" Foreground="#22D3EE" FontSize="21" FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
            <Grid Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,5">
                <TextBlock Text="CPU" Foreground="#8B949E" FontSize="11" />
                <TextBlock Text="{Binding CpuText}" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <Grid Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,5">
                <TextBlock Text="GPU" Foreground="#8B949E" FontSize="11" />
                <TextBlock Text="{Binding GpuText}" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <Grid Visibility="{Binding ShowRam, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="RAM" Foreground="#8B949E" FontSize="11" />
                <TextBlock Text="{Binding RamText}" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
