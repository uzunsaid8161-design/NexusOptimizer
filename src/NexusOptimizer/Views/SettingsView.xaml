<UserControl x:Class="NexusOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Pop" b:Animations.Hover="Card">
                <StackPanel>
                    <TextBlock Text="BEWEGUNG" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Passe Animationen an. Die Auswahl wird sofort gespeichert und für Seitenwechsel sowie Mikrointeraktionen verwendet."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Animationsmodus" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MotionModes}" SelectedItem="{Binding MotionMode, Mode=TwoWay}"
                                  MinWidth="180" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Animationsgeschwindigkeit" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding AnimationSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding AnimationSpeed, StringFormat={}{0:0.0}x}" Foreground="{StaticResource Cyan}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Button Content="Bewegungseinstellungen speichern" Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="1">
                <StackPanel>
                    <TextBlock Text="WINDOWS-AUTOSTART" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding StartupStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,7,0,12" TextWrapping="Wrap" />
                    <Button Content="{Binding StartupButtonText}" Command="{Binding ToggleStartupCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="2">
                <StackPanel>
                    <TextBlock Text="LOKALE DATEN" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding DataFolder}" Foreground="{StaticResource Cyan}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatabaseFile}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Button Content="Datenordner öffnen" Command="{Binding OpenDataFolderCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <TextBlock Text="NexusOptimizer sendet keine Telemetrie. Einstellungen und Sitzungen bleiben lokal auf diesem PC."
                               Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Success}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
