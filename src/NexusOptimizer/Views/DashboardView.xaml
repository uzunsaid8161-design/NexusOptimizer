<UserControl x:Class="NexusOptimizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NexusOptimizer.Controls"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border x:Name="HeroCard" Style="{StaticResource GlassCard}" Padding="24,20"
                b:Animations.Entry="Pop" b:Animations.Hover="Card">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="LiveDotScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#34D399" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="LIVE-FPS" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:AnimatedNumber Value="{Binding FpsValue}" Format="0.0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="72" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="FPS" Foreground="{StaticResource Cyan}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="10,0,0,16" />
                        <TextBlock Text="{Binding FrameTimeText}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   VerticalAlignment="Bottom" Margin="14,0,0,22" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="5" Width="620" VerticalAlignment="Center">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="MIN" Style="{StaticResource CardTitle}" />
                        <ui:AnimatedNumber Value="{Binding MinValue}" Format="0" Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="AVG" Style="{StaticResource CardTitle}" />
                        <ui:AnimatedNumber Value="{Binding AvgValue}" Format="0" Foreground="{StaticResource Cyan}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="MAX" Style="{StaticResource CardTitle}" />
                        <ui:AnimatedNumber Value="{Binding MaxValue}" Format="0" Foreground="{StaticResource Violet}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="1 %-LOW" Style="{StaticResource CardTitle}" />
                        <ui:AnimatedNumber Value="{Binding Low1Value}" Format="0" Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="0,1 %-LOW" Style="{StaticResource CardTitle}" />
                        <ui:AnimatedNumber Value="{Binding Low01Value}" Format="0" Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Diagramm + System -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,16,0"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="1" b:Animations.Hover="Card">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="FPS-VERLAUF · 60 S" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Compositor-Sampling" Foreground="#5C6880" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>

                    <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,14,0,0" ClipToBounds="True">
                        <Polygon x:Name="AreaPolygon" Fill="{StaticResource AreaGradient}" />
                        <Polyline x:Name="FpsPolyline" Stroke="{StaticResource Cyan}" StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Grid.Column="1"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="2" b:Animations.Hover="Card">
                <StackPanel>
                    <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <StackPanel>
                            <ui:AnimatedRing Value="{Binding CpuPercent}" Width="82" Height="82" Thickness="8" HorizontalAlignment="Center" />
                            <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <ui:AnimatedNumber Value="{Binding CpuPercent}" Format="0' %'" Foreground="{StaticResource TextPrimary}"
                                               FontSize="12" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <ui:AnimatedRing Value="{Binding GpuPercent}" Width="82" Height="82" Thickness="8" HorizontalAlignment="Center" />
                            <TextBlock Text="GPU" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <ui:AnimatedNumber Value="{Binding GpuPercent}" Format="0' %'" Foreground="{StaticResource TextPrimary}"
                                               FontSize="12" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <ui:AnimatedRing Value="{Binding RamPercent}" Width="82" Height="82" Thickness="8" HorizontalAlignment="Center" />
                            <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding RamText}" Foreground="{StaticResource TextPrimary}" FontSize="11"
                                       HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,12" />

                    <Button Content="RAM freigeben" Command="{Binding FreeMemoryCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding FreeRamText}" Foreground="{StaticResource TextPrimary}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MemoryStatus}" Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,4,0,0" TextAlignment="Center" />

                    <Border Height="1" Background="#14FFFFFF" Margin="0,12,0,10" />

                    <TextBlock Text="Frametime-Warnung" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="&gt; 16,7 ms = gelb · &gt; 33 ms = rot" Foreground="#5C6880" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
