<UserControl x:Class="NexusOptimizer.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NexusOptimizer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LIVE-MONITORING" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Detaillierte Echtzeitwerte für Frametimes und Systemlast."
                                   Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,7,0,0" />
                        <TextBlock Text="Quelle: Nexus-App-Compositor. Das ist keine spielgenaue FPS-Messung."
                                   Foreground="{StaticResource Warning}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:AnimatedNumber Value="{Binding CurrentFps}" Format="0.0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="58" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,13">
                            <TextBlock Text="FPS" Foreground="{StaticResource Cyan}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FrameTimeMs, StringFormat={}{0:0.00} ms}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="60-S-MIN" Style="{StaticResource CardTitle}" /><ui:AnimatedNumber Value="{Binding MinimumFps}" Format="0" FontFamily="{StaticResource MonoFont}" FontSize="26" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="60-S-AVG" Style="{StaticResource CardTitle}" /><ui:AnimatedNumber Value="{Binding AverageFps}" Format="0" FontFamily="{StaticResource MonoFont}" FontSize="26" Foreground="{StaticResource Cyan}" Margin="0,8,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="60-S-MAX" Style="{StaticResource CardTitle}" /><ui:AnimatedNumber Value="{Binding MaximumFps}" Format="0" FontFamily="{StaticResource MonoFont}" FontSize="26" Foreground="{StaticResource Violet}" Margin="0,8,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Padding="18">
                    <StackPanel><TextBlock Text="1 %-LOW" Style="{StaticResource CardTitle}" /><ui:AnimatedNumber Value="{Binding Low1Fps}" Format="0" FontFamily="{StaticResource MonoFont}" FontSize="26" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" /></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Padding="22" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FPS-VERLAUF · LETZTE 60 SEKUNDEN" Style="{StaticResource CardTitle}" />
                        <ui:Sparkline x:Name="FpsSparkline" Height="120" Stroke="{StaticResource Cyan}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="SYSTEMLAST" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CpuText}" Foreground="{StaticResource TextPrimary}" FontSize="15" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding GpuText}" Foreground="{StaticResource TextPrimary}" FontSize="15" Margin="0,8,0,0" />
                        <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding RamText}" Foreground="{StaticResource TextPrimary}" FontSize="15" />
                        <TextBlock Text="60-S-FENSTER" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding Low01Text}" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="APP-LAUFZEIT" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UptimeText}" Foreground="{StaticResource TextPrimary}" FontSize="14"
                               FontFamily="{StaticResource MonoFont}" Margin="10,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="FPS-Messpunkte" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SamplesRecorded}" Foreground="{StaticResource TextPrimary}" FontSize="14"
                               FontFamily="{StaticResource MonoFont}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
