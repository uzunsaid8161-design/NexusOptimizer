<UserControl x:Class="NexusOptimizer.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Pop" b:Animations.Hover="Card">
                <StackPanel>
                    <TextBlock Text="LIVE-OVERLAY" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Zeigt FPS aus dem Nexus-App-Compositor sowie CPU-, GPU- und RAM-Werte als kleines, click-through Fenster. Es bleibt im Vordergrund, stiehlt keinen Fokus und funktioniert bei randlosem Fenstermodus. Exklusives Vollbild kann es verbergen."
                               Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,9,0,0" TextWrapping="Wrap" MaxWidth="820" />
                    <Button Content="{Binding ToggleButtonText}"
                            Command="{Binding ToggleOverlayCommand}" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="1">
                <StackPanel>
                    <TextBlock Text="ANZEIGE" Style="{StaticResource CardTitle}" />
                    <CheckBox Content="FPS" IsChecked="{Binding ShowFps}" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,0" />
                    <CheckBox Content="CPU-Auslastung" IsChecked="{Binding ShowCpu}" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" />
                    <CheckBox Content="GPU-Auslastung (falls Windows Messwerte liefert)" IsChecked="{Binding ShowGpu}" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" />
                    <CheckBox Content="RAM-Belegung" IsChecked="{Binding ShowRam}" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Deckkraft" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.55" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding OverlayOpacity, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" Foreground="{StaticResource Cyan}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Button Content="Layout speichern" Command="{Binding SaveLayoutCommand}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
