<UserControl x:Class="NexusOptimizer.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Gesicherte zurücksetzen" Command="{Binding ResetAllCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="Sichere Tweaks anwenden" Command="{Binding ApplyAllCommand}" Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,6,10"
                                b:Animations.Entry="Pop" b:Animations.Hover="Card" b:Animations.Press="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" />
                                        <Border Margin="10,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource RiskBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Risk}" Value="Mittel">
                                                            <Setter Property="Background" Value="#1AFBBF24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Risk}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,4,0,0"
                                               TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Cyan}" FontSize="10.5" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAvailable, Mode=OneWay}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOneShot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Button Content="Einmal ausführen"
                                            Command="{Binding DataContext.RunOneShotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOneShot}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
