<Window x:Class="NexusOptimizer.Views.MotionPlaygroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NexusOptimizer.Controls"
        xmlns:b="clr-namespace:NexusOptimizer.Behaviors"
        Title="Motion Playground"
        Width="1040" Height="700"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0E14" Offset="0" />
                <GradientStop Color="#131829" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="Motion Playground" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                       Margin="18,0,0,0" VerticalAlignment="Center" />
            <Button Content="✕" Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Margin="0,0,8,0" Click="OnClose" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="AUSLÖSEN" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                <Button Content="Fade In" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnFade" />
                <Button Content="Slide In" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnSlide" />
                <Button Content="Pop In" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnPop" />
                <Button Content="Stagger (Liste)" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnStagger" />
                <Button Content="Pulse" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnPulse" />
                <Button Content="Shake (Fehler)" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnShake" />
                <Button Content="Ripple" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnRipple" />
                <Button Content="Toast" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnToast" />
                <Button Content="Count-Up" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnCount" />
                <Button Content="Ring-Chart" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnRing" />
                <Button Content="Sparkline-Punkt" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnSpark" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="DemoCard" Style="{StaticResource GlassCard}" Padding="18,12" Width="220"
                                b:Animations.Hover="Card" b:Animations.Press="True" b:Animations.Entry="Pop">
                            <StackPanel>
                                <TextBlock Text="Demo-Karte" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                                <TextBlock Text="Hover &amp; Klick testen" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <ui:RippleButton x:Name="RippleTarget" Content="Ripple-Button" Style="{StaticResource GhostButton}"
                                         Margin="14,0,0,0" VerticalAlignment="Center" />

                        <ui:AnimatedRing x:Name="Ring" Width="84" Height="84" Value="0" Thickness="9" Margin="18,0,0,0" />
                        <ui:AnimatedNumber x:Name="Number" Value="0" FontFamily="{StaticResource MonoFont}" FontSize="34"
                                           Foreground="{StaticResource TextPrimary}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="StaggerList">
                            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,8" b:Animations.Entry="Stagger" b:Animations.EntryIndex="0">
                                <TextBlock Text="Eintrag 1" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,8" b:Animations.Entry="Stagger" b:Animations.EntryIndex="1">
                                <TextBlock Text="Eintrag 2" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,8" b:Animations.Entry="Stagger" b:Animations.EntryIndex="2">
                                <TextBlock Text="Eintrag 3" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Padding="14,10" b:Animations.Entry="Stagger" b:Animations.EntryIndex="3">
                                <TextBlock Text="Eintrag 4" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="SPARKLINE" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,8,0,0" Height="90">
                                <ui:Sparkline x:Name="Spark" Stroke="{StaticResource Cyan}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0CFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Motion" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                    <ComboBox x:Name="LevelBox" Width="130" Margin="10,0,24,0" SelectionChanged="OnLevelChanged">
                        <ComboBoxItem Content="Voll" IsSelected="True" />
                        <ComboBoxItem Content="Wenig" />
                        <ComboBoxItem Content="Aus" />
                    </ComboBox>

                    <TextBlock Text="Speed" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                    <Slider x:Name="SpeedSlider" Width="240" Minimum="0.5" Maximum="2" Value="1" Margin="10,0,0,0"
                            ValueChanged="OnSpeedChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="SpeedText" Text="1,0×" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ToastHost x:Name="Toasts" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10" />
    </Grid>
</Window>
