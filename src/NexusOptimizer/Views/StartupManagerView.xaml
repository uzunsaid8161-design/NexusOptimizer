<UserControl x:Class="NexusOptimizer.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,160,0">
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PermissionText}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="12,8" FontSize="12"
                                 Background="#121722" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="#334155" BorderThickness="1"
                                 ToolTip="Suche nach Name, Quelle, Hersteller oder Befehl" />
                        <TextBlock Text="Suche nach App, Quelle oder Befehl" Margin="13,0,8,0"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}"
                              Height="36" VerticalContentAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleEntries}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding VisibleEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Padding="18,13" Margin="0,0,6,9"
                                    b:Animations.Entry="Pop" b:Animations.Hover="Card">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock FontSize="10" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktiv" />
                                                    <Setter Property="Foreground" Value="{StaticResource Cyan}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Deaktiviert · gesichert" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Location}" Foreground="{StaticResource Cyan}" FontSize="10" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,14,0"
                                                   TextWrapping="Wrap" MaxHeight="34" />
                                        <TextBlock Text="{Binding Availability}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Deaktivieren" Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="IsEnabled" Value="{Binding CanManage}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Aktivieren" Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="IsEnabled" Value="{Binding CanManage}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Padding" Value="24" />
                        <Setter Property="MinHeight" Value="120" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleEntries}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource TextMuted}" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
