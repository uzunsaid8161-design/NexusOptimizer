<UserControl x:Class="NexusOptimizer.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:NexusOptimizer.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Pop" b:Animations.Hover="Card">
                <StackPanel>
                    <TextBlock Text="LOKALE SICHERUNG" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Erstelle oder stelle eine Kopie deiner Sitzungen, FPS-Daten, Einstellungen und des Optimierungsprotokolls wieder her. NexusOptimizer verändert dabei keine Cloud- oder Netzwerkdaten."
                               Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="760" />
                    <TextBlock Text="Datenbank" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,18,0,3" />
                    <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource Cyan}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="Automatische Vorsicherungen vor einer Wiederherstellung liegen in:" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,10,0,3" />
                    <TextBlock Text="{Binding BackupDirectory}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,14"
                    b:Animations.Entry="Stagger" b:Animations.EntryIndex="1">
                <StackPanel>
                    <TextBlock Text="AKTIONEN" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Sicherung erstellen" Command="{Binding CreateBackupCommand}"
                                Style="{StaticResource AccentButton}" IsEnabled="{Binding CanRun}" />
                        <Button Content="Sicherung wiederherstellen" Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" IsEnabled="{Binding CanRun}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11"
                               Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
