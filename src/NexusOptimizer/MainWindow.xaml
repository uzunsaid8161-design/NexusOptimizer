<Window x:Class="NexusOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:NexusOptimizer.Controls"
        Title="NexusOptimizer"
        Icon="pack://application:,,,/Assets/app.png"
        Width="1280" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0B0E14"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootTranslate" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0E14" Offset="0" />
                <GradientStop Color="#0E1320" Offset="0.55" />
                <GradientStop Color="#131829" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titelleiste -->
        <Grid x:Name="TitleBar" Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Width="18" Height="18" Source="pack://application:,,,/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="NexusOptimizer" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Background="#141C2A" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text=".NET 8" Foreground="#7C8AA5" FontSize="9" FontWeight="Bold" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="Minimieren" />
                <Button Content="□" Style="{StaticResource WindowButton}" Click="OnToggleMaximize" ToolTip="Maximieren / Fenster" />
                <Button Content="⛶" Style="{StaticResource WindowButton}" Click="OnToggleFullscreen" ToolTip="Vollbild (F11)" />
                <Button Content="✕" Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Schließen" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: klappt beim Hovern auf und zeigt Beschriftungen -->
            <Border x:Name="Sidebar" Width="76" ClipToBounds="True" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="0,1,1,0"
                    MouseEnter="OnSidebarEnter" MouseLeave="OnSidebarLeave">
                <StackPanel Margin="0,16" HorizontalAlignment="Stretch">
                    <RadioButton Style="{StaticResource NavButton}" ToolTip="Dashboard" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◆" FontSize="16" Width="22" />
                            <TextBlock x:Name="NavLabel0" Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" ToolTip="Statistik"
                                 Command="{Binding NavigateCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="16" Width="22" />
                            <TextBlock x:Name="NavLabel1" Text="Statistik" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" ToolTip="Optimizer"
                                 Command="{Binding NavigateCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="22" />
                            <TextBlock x:Name="NavLabel2" Text="Optimizer" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" ToolTip="Overlay"
                                 Command="{Binding NavigateCommand}" CommandParameter="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◎" FontSize="16" Width="22" />
                            <TextBlock x:Name="NavLabel3" Text="Overlay" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" ToolTip="Einstellungen"
                                 Command="{Binding NavigateCommand}" CommandParameter="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛭" FontSize="16" Width="22" />
                            <TextBlock x:Name="NavLabel4" Text="Einstellungen" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Inhalt -->
            <Grid Grid.Column="1" Margin="26,10,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Motion" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnOpenMotion" />
                        <Button Content="⚙  Optimizer öffnen" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding NavigateCommand}" CommandParameter="2" />
                        <Border CornerRadius="10" Padding="12,6" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <TextBlock FontSize="11" Text="Standardmodus" Foreground="{StaticResource Warning}"
                                       Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisibility}}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <ui:CrossFadeHost x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
